# Optional local settings. Defaults work without creating .env.
# This file contains no payment keys or production configuration.
OCP_HTTP_PORT=18180

# Per-process connection ceiling (also configurable directly on internal roles).
OCP_DB_MAX_OPEN=8
OCP_DB_MAX_IDLE=4

# Optional OTLP/HTTP export. No receiver or Grafana is required for development.
# 'none' sends no telemetry. Point to your receiver before selecting 'otlp-http'.
OCP_OTEL_EXPORTER=none
OCP_OTEL_TRACE_SAMPLE_RATIO=0.1
# A receiver on the Docker Desktop host is reachable through host.docker.internal.
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# Set only in ignored local configuration if the receiver requires credentials.
OTEL_EXPORTER_OTLP_HEADERS=
