{
  "name": "@ocp/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "cookie": "0.7.2"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "contracts:generate": "openapi-typescript ../../contracts/build/provider.openapi.json -o src/lib/api/generated.d.ts",
    "contracts:check": "openapi-typescript ../../contracts/build/provider.openapi.json -o /tmp/ocp-generated.d.ts && diff -u src/lib/api/generated.d.ts /tmp/ocp-generated.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "svelte": "5.57.2",
    "vite": "7.3.7",
    "typescript": "5.9.3",
    "svelte-check": "4.7.7",
    "vitest": "4.1.12",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "27.4.0",
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0",
    "@types/node": "24.19.2"
  }
}
