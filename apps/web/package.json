{
  "name": "@ocp/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18181 --strictPort",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "test": "vitest run",
    "test:mutation": "svelte-kit sync && stryker run",
    "test:browser": "playwright test",
    "contracts:generate": "openapi-typescript ../../contracts/build/provider.openapi.json -o src/lib/api/generated.d.ts",
    "contracts:check": "openapi-typescript ../../contracts/build/provider.openapi.json -o /tmp/ocp-generated.d.ts && diff -u src/lib/api/generated.d.ts /tmp/ocp-generated.d.ts"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "@lucide/svelte": "1.61.0",
    "@tanstack/svelte-query": "6.3.5",
    "openapi-fetch": "0.17.0",
    "xstate": "5.33.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.2",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
